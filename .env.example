# Copy this file to ".env" (same folder) and adjust. Real environment
# variables (e.g. set on Render) always win over this file.

# development | production  (production enforces the checks below)
APP_ENV=development

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Leave empty to use SQLite in instance/paramount.db.
# Online (Neon/Supabase Postgres): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# How long a login lasts on a device
SESSION_MAX_AGE_DAYS=30

# Largest upload (course notes)
MAX_UPLOAD_MB=10

# Supabase Storage (required in production; optional locally)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=paramount-files
